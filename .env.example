# One server serves main app, camera app, and API. No variables required for localhost.
PORT=8787
# Keep this directory persistent in production. Default: .fridgeful-data under project root.
# DATA_DIR=/data
# For local trusted HTTPS on phones, supply certificate and key paths.
# TLS_CERT=./certs/local.pem
# TLS_KEY=./certs/local-key.pem
# Only for hosting the frontend separately from this backend (comma-separated exact HTTPS origins).
# ALLOWED_ORIGINS=https://your-main.example
# Build-time public backend origin when hosting frontend separately. Leave blank for one-server deployment.
VITE_CAMERA_API_URL=

# Exact public frontend URL, if the app is behind a tunnel/reverse proxy.
# PUBLIC_APP_URL=https://your-app.example
# Trust X-Forwarded-Host only when a reverse proxy you control supplies it.
# TRUST_PROXY=true
# npm run dev uses FRONTEND_PORT (default 5173), independently of server PORT.
# FRONTEND_PORT=5173

# Server-side image analysis. Never prefix this secret with VITE_ or put it in frontend files.
# Add a paid provider key, restart the server, then enable automation with consent in Paired cameras.
GEMINI_API_KEY=
VISION_MODEL=gemini-3.8-flash

# Optional: use a separately selected Gemini model for single-photo food/meal uploads.
# If unset, VISION_MODEL is used. Choose a Flash model available to your API project.
MEAL_VISION_MODEL=
